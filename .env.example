# API Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Supabase PostgreSQL in production, default SQLite fallback in local dev if omitted)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# CORS & CSRF Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Owner Configuration (Required in production)
OWNER_USERNAME=admin
OWNER_EMAIL=owner@example.com

# Web Application Configuration
# Leave blank for same-origin rewrites via Next.js, or specify explicit backend URL
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://localhost:8000
