# Django API Environment Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Supabase PostgreSQL)
# Local fallback: SQLite is used if DATABASE_URL is commented out.
# Production requirement: Supabase PostgreSQL connection string with TLS.
# Example Supabase Session Pooler connection string:
# DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_CONNECT_TIMEOUT=10
DATABASE_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=false

# Initial Account Provisioning & Owner Identity Configuration
# Required in production: at least one of OWNER_USERNAME or OWNER_EMAIL must be set.
OWNER_USERNAME=admin
OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=replace-with-secure-owner-password

# CORS & CSRF Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
